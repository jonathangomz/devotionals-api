# MongoDB connection string used by the app (see src/app.module.ts).
# Copy this file to .env and replace the placeholder with a real connection
# string. Never commit .env or a real credential.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Port the HTTP server listens on. Optional, defaults to 3000.
# PORT=3000
